{
  "name": "homebridge.io",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "The https://homebridge.io website",
  "engines": {
    "node": "^24 || ^26"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "watch": "ng serve",
    "build": "NG_BUILD_SASS_EMBEDDED=0 ng build --configuration production",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@fortawesome/angular-fontawesome": "^5.1.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "bootstrap": "^5.3.8",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^22.6.0",
    "@angular-eslint/eslint-plugin-template": "^22.6.0",
    "@angular-eslint/template-parser": "^22.6.0",
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@antfu/eslint-config": "^9.5.1",
    "@prettier/plugin-xml": "^3.4.2",
    "@types/node": "^24.10.1",
    "eslint": "^10.13.0",
    "eslint-plugin-format": "^2.0.1",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true,
    "@fortawesome/fontawesome-common-types": false,
    "@fortawesome/fontawesome-svg-core": false,
    "@fortawesome/free-brands-svg-icons": false,
    "@fortawesome/free-regular-svg-icons": false,
    "@fortawesome/free-solid-svg-icons": false,
    "nx": false,
    "@parcel/watcher": false,
    "nice-napi": false
  },
  "overrides": {
    "@antfu/eslint-config": {
      "@angular-eslint/eslint-plugin": "^22.2.0",
      "@angular-eslint/eslint-plugin-template": "^22.2.0",
      "@angular-eslint/template-parser": "^22.2.0"
    }
  }
}
